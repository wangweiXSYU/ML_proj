    "from tqdm import tqdm\n",
    "import time\n",
    "\n",
    "# 定义一个生成器函数\n",
    "def my_generator():\n",
    "    for i in range(10):\n",
    "        yield i\n",
    "        time.sleep(0.5)\n",
    "\n",
    "# 使用 tqdm 包装生成器\n",
    "for item in tqdm(my_generator()):\n",
    "    pass"
